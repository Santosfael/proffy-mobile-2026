<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.finallyComponent.FinallyActivity"
    android:background="@color/purple">

    <ImageView
        android:id="@+id/imageViewBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/background_flow_completed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:layout_marginBottom="190dp" />

    <LinearLayout
        android:id="@+id/containerBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="180dp"
        android:layout_marginBottom="180dp"
        android:gravity="center_horizontal">
        <ImageView
            android:id="@+id/imageViewDone"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/done"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/textViewTitleFinally"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Cadastro\nconcluído!"
            android:fontFamily="@font/poppins_semibold"
            android:textSize="32sp"
            android:textColor="@color/text_in_purple_title"
            android:textAlignment="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/textViewSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Agora você faz parte da\nplataforma da Proffy"
            android:textAlignment="center"
            android:fontFamily="@font/poppins"
            android:textSize="14sp"
            android:textColor="@color/text_in_purple_base" />
    </LinearLayout>

    <Button
        android:id="@+id/buttonGoToLogin"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintTop_toBottomOf="@+id/containerBackground"
        android:layout_marginTop="50dp"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:backgroundTint="@color/green"
        tools:text="Voltar ao login"
        android:textAllCaps="false"
        android:fontFamily="@font/archivo_semibold"
        android:textSize="16sp"
        android:elevation="0dp" />


</androidx.constraintlayout.widget.ConstraintLayout>